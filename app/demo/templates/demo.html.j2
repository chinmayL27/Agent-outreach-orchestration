<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ config.business_name }} - Patient Assistant Demo</title>
<style>
  :root {
    --accent: {{ config.accent_color }};
    --bg: #f4f6f8;
    --panel: #ffffff;
    --ink: #10181f;
    --muted: #5b6b7a;
    --line: #e2e8f0;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .demo-banner {
    background: #1f2937; color: #f9fafb; text-align: center;
    padding: 8px 16px; font-size: 13px; letter-spacing: .02em;
  }
  .site { max-width: 1040px; margin: 0 auto; padding: 24px 20px 80px; }
  .site-header {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; padding-bottom: 18px; border-bottom: 1px solid var(--line);
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .logo {
    width: 46px; height: 46px; border-radius: 12px; background: var(--accent);
    color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 18px;
  }
  .brand h1 { font-size: 21px; margin: 0; }
  .brand p { margin: 2px 0 0; color: var(--muted); font-size: 13px; }
  .nav { color: var(--muted); font-size: 14px; display: flex; gap: 18px; }
  .layout { display: grid; grid-template-columns: 1fr 380px; gap: 28px; margin-top: 26px; }
  @media (max-width: 880px) { .layout { grid-template-columns: 1fr; } }
  .card {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 14px; padding: 20px;
  }
  .card h2 { margin: 0 0 12px; font-size: 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    border: 1px solid var(--line); border-radius: 999px;
    padding: 6px 12px; font-size: 13px; color: var(--muted); background: #fbfdff;
  }
  .chat {
    background: var(--panel); border: 1px solid var(--line); border-radius: 14px;
    overflow: hidden; display: flex; flex-direction: column; height: 520px;
  }
  .chat-head { background: var(--accent); color: #fff; padding: 14px 16px; }
  .chat-head strong { display: block; font-size: 15px; }
  .chat-head span { font-size: 12px; opacity: .85; }
  .chat-log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
  .msg { max-width: 86%; padding: 10px 13px; border-radius: 13px; font-size: 14px; white-space: pre-wrap; }
  .msg.bot { background: #eef2f6; border-bottom-left-radius: 4px; align-self: flex-start; }
  .msg.user { background: var(--accent); color: #fff; border-bottom-right-radius: 4px; align-self: flex-end; }
  .typing { display: inline-flex; gap: 4px; }
  .typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: blink 1.2s infinite; }
  .typing i:nth-child(2) { animation-delay: .2s; }
  .typing i:nth-child(3) { animation-delay: .4s; }
  @keyframes blink { 0%, 60%, 100% { opacity: .25 } 30% { opacity: 1 } }
  .chat-input { border-top: 1px solid var(--line); padding: 12px; display: flex; gap: 8px; }
  .chat-input input {
    flex: 1; border: 1px solid var(--line); border-radius: 9px;
    padding: 10px 12px; font-size: 14px; font-family: inherit;
  }
  .chat-input button {
    border: 0; border-radius: 9px; background: var(--accent); color: #fff;
    padding: 10px 16px; font-size: 14px; cursor: pointer;
  }
  .overlay {
    position: fixed; inset: 0; background: linear-gradient(140deg, #0b1220, #143f3a);
    color: #fff; display: none; place-items: center; text-align: center; padding: 8vw; z-index: 20;
  }
  .overlay.show { display: grid; }
  .overlay h2 { font-size: clamp(22px, 3.4vw, 40px); margin: 0 0 14px; line-height: 1.25; }
  .overlay p { font-size: clamp(15px, 1.7vw, 20px); margin: 0; color: #cbd5e1; max-width: 900px; }
  .overlay .tag {
    display: inline-block; margin-bottom: 20px; padding: 6px 14px; border-radius: 999px;
    background: rgba(255,255,255,.12); font-size: 13px; letter-spacing: .08em; text-transform: uppercase;
  }
  .foot { margin-top: 26px; color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<div class="demo-banner">{{ config.disclaimer }}</div>

<div class="site">
  <header class="site-header">
    <div class="brand">
      <div class="logo">{{ initials }}</div>
      <div>
        <h1>{{ config.business_name }}</h1>
        <p>{{ config.specialty }}{% if config.location %} &middot; {{ config.location }}{% endif %}</p>
      </div>
    </div>
    <nav class="nav"><span>Services</span><span>Providers</span><span>Contact</span></nav>
  </header>

  <div class="layout">
    <main>
      <div class="card">
        <h2>Services listed on your website</h2>
        {% if config.services %}
        <div class="chips">
          {% for service in config.services %}<span class="chip">{{ service }}</span>{% endfor %}
        </div>
        {% else %}
        <p style="color:var(--muted);margin:0">No services were extracted from the public website.</p>
        {% endif %}
      </div>
      <div class="card" style="margin-top:18px">
        <h2>What this demo shows</h2>
        <p style="color:var(--muted);margin:0">
          A website assistant that answers patient questions using only what
          {{ config.business_name }} already publishes, then routes the patient to the right
          service, location, or appointment request.
        </p>
      </div>
      <p class="foot">{{ config.cta_text }}</p>
    </main>

    <aside>
      <div class="chat">
        <div class="chat-head">
          <strong>{{ config.business_name }} Assistant</strong>
          <span>Sample assistant &middot; demo only</span>
        </div>
        <div class="chat-log" id="chat-log"></div>
        <div class="chat-input">
          <input id="chat-input" type="text" placeholder="Ask a question&hellip;" autocomplete="off" />
          <button id="chat-send" type="button">Send</button>
        </div>
      </div>
    </aside>
  </div>
</div>

<div class="overlay" id="overlay-intro">
  <div>
    <span class="tag">Personalized demo</span>
    <h2 id="overlay-intro-title"></h2>
    <p id="overlay-intro-sub"></p>
  </div>
</div>
<div class="overlay" id="overlay-outro">
  <div>
    <span class="tag">Next step</span>
    <h2 id="overlay-outro-title"></h2>
    <p id="overlay-outro-sub"></p>
  </div>
</div>

<script id="demo-config" type="application/json">{{ config_json | safe }}</script>
<script>
(function () {
  const CONFIG = JSON.parse(document.getElementById("demo-config").textContent);
  const log = document.getElementById("chat-log");
  const input = document.getElementById("chat-input");
  const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

  function addMessage(role, text) {
    const node = document.createElement("div");
    node.className = "msg " + role;
    node.textContent = text;
    log.appendChild(node);
    log.scrollTop = log.scrollHeight;
    return node;
  }

  function answerFor(question) {
    if (CONFIG.answers && CONFIG.answers[question]) return CONFIG.answers[question];
    const key = Object.keys(CONFIG.answers || {}).find(
      (k) => k.toLowerCase().includes(question.toLowerCase().slice(0, 12))
    );
    if (key) return CONFIG.answers[key];
    return (
      "I answer from " + CONFIG.business_name + "'s published website content. " +
      "Try one of the suggested questions, or ask about services, locations or appointments."
    );
  }

  async function typeInto(text, msPerChar) {
    input.value = "";
    for (const char of text) {
      input.value += char;
      await sleep(msPerChar);
    }
  }

  async function showTyping(ms) {
    const node = addMessage("bot", "");
    node.innerHTML = '<span class="typing"><i></i><i></i><i></i></span>';
    await sleep(ms);
    node.remove();
  }

  async function ask(question, opts) {
    const options = opts || {};
    await typeInto(question, options.msPerChar === undefined ? 28 : options.msPerChar);
    await sleep(200);
    addMessage("user", question);
    input.value = "";
    await showTyping(options.thinkMs === undefined ? 900 : options.thinkMs);
    addMessage("bot", answerFor(question));
  }

  function overlay(id, title, subtitle, visible) {
    const node = document.getElementById(id);
    document.getElementById(id + "-title").textContent = title || "";
    document.getElementById(id + "-sub").textContent = subtitle || "";
    node.classList.toggle("show", visible !== false);
  }

  function greet() {
    log.innerHTML = "";
    addMessage(
      "bot",
      "Hi! I'm the " + CONFIG.business_name + " assistant. I can answer questions about " +
      ((CONFIG.services || []).slice(0, 3).join(", ") || "our services") +
      ", locations and appointments."
    );
  }

  document.getElementById("chat-send").addEventListener("click", () => {
    const question = input.value.trim();
    if (!question) return;
    addMessage("user", question);
    input.value = "";
    setTimeout(() => addMessage("bot", answerFor(question)), 500);
  });
  input.addEventListener("keydown", (event) => {
    if (event.key === "Enter") document.getElementById("chat-send").click();
  });

  // Control surface used by the video recorder (Playwright drives these).
  window.demo = {
    config: CONFIG,
    ask,
    greet,
    showIntro: (title, sub) => overlay("overlay-intro", title || CONFIG.intro_text, sub || CONFIG.business_name, true),
    hideIntro: () => document.getElementById("overlay-intro").classList.remove("show"),
    showOutro: (title, sub) => overlay("overlay-outro", title || CONFIG.outro_text, sub || CONFIG.cta_text, true),
    hideOutro: () => document.getElementById("overlay-outro").classList.remove("show"),
    ready: true,
  };

  greet();
  if (new URLSearchParams(location.search).get("intro") === "1") {
    window.demo.showIntro();
  }
})();
</script>
</body>
</html>
