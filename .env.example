# ---------------------------------------------------------------------------
# Copy to .env and edit.  Never commit .env.
# ---------------------------------------------------------------------------

# Storage -------------------------------------------------------------------
OUTREACH_DB_URL=sqlite:///outreach.db
OUTREACH_ARTIFACTS_DIR=artifacts

# LLM provider: template | claude_cli | ollama | anthropic
#   template   - deterministic, no LLM required (default; use it for test runs)
#   claude_cli - shells out to the locally installed `claude` CLI (Claude Max)
#   ollama     - local model over http://localhost:11434
#   anthropic  - Anthropic API (requires separate API credits)
LLM_PROVIDER=template
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_TIMEOUT=180
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Crawler -------------------------------------------------------------------
MAX_PAGES_PER_SITE=15
REQUEST_TIMEOUT=10
CRAWL_DELAY=0.5
USER_AGENT=outreach-agent/0.1 (+https://example.com/bot)
RESPECT_ROBOTS=true
# Only the bundled offline demo needs this; real crawls are http(s) only and
# private/loopback/link-local/metadata destinations are always refused.
ALLOW_FILE_URLS=true

# Video ---------------------------------------------------------------------
# Optional. Auto-detected when unset (PATH, then the Playwright bundle).
# FFMPEG_BIN=
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720

# Demo page -----------------------------------------------------------------
DEMO_BASE_URL=http://localhost:8000
# Where demos/videos are published for recipients. Until this is set, emails
# carry no demo link and sending via a real provider is refused: localhost and
# file:// links are useless to a clinic.
# PUBLIC_ARTIFACT_BASE_URL=https://demos.yourcompany.com

# Email ---------------------------------------------------------------------
# Sender: console | smtp   (console writes .eml files to artifacts/outbox)
EMAIL_PROVIDER=console
SENDER_NAME=Your Name
SENDER_EMAIL=you@yourcompany.com
SENDER_COMPANY=Your Company, Inc.
# CAN-SPAM requires a valid physical postal address in every commercial message.
SENDER_POSTAL_ADDRESS=123 Example St, Suite 100, San Jose, CA 95113
UNSUBSCRIBE_MAILTO=unsubscribe@yourcompany.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
